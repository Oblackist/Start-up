# Career Arena · Exam Arena — frontend env
#
# This file documents the supported env vars. Copy to `.env` for local dev.
# VITE_API_URL is *not* a secret — it's public config baked into the bundle —
# but we still keep `.env` out of git to avoid committing per-developer URLs.

# Base URL of the Flask backend (no trailing slash).
VITE_API_URL=

# Cloudflare Turnstile (login CAPTCHA) — OPTIONAL.
# Cloudflare Turnstile Test Keys (Development üçün)
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# When VITE_TURNSTILE_SITE_KEY is empty, no widget is rendered and no token is
# sent (the backend then also skips verification unless its own key is set).
# Never put the SECRET key here — VITE_* vars are public by definition.
VITE_TURNSTILE_SITE_KEY=

# Backend env (NEVER commit real secrets — .env.example ships placeholders only)
backend/.env
backend/instance/
backend/__pycache__/
backend/**/__pycache__/
backend/*.db
backend/**/*.db
backend/.venv/
backend/**/.venv/

# Frontend env (dev-only — VITE_API_URL is public config, but keep it out of git)
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/cache/

# Local launcher files
.venv/
__pycache__/
*.pyc

# Editor / OS noise
.DS_Store
.idea/
.vscode/
*.log

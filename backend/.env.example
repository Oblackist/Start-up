# ---------------------------------------------------------------------------
# Career Arena · Exam Arena — backend environment template
#
# Copy to `.env` and edit:   cp .env.example .env
# `.env` is gitignored. Placeholders only — NEVER put real secrets here.
# In production (FLASK_ENV=production) the app refuses to boot unless the
# secrets below are set to strong (>=16 char, non-placeholder) values.
# ---------------------------------------------------------------------------

# Flask
# Strong random string, >= 16 chars (e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`)
FLASK_ENV=development
SECRET_KEY=change-me-32+random-bytes-please

# SQLite file (relative paths resolve against the backend root).
# DATABASE_URL=sqlite:///instance/app.db

# CORS — the single allowed frontend origin (no wildcards).
FRONTEND_ORIGIN=http://localhost:5173

# Session / CSRF cookies
SESSION_TTL_HOURS=12
SESSION_IDLE_TTL_MINUTES=30

# Password pepper — HMAC-SHA-256 key mixed into every password BEFORE Argon2.
# >= 16 chars, unique per deployment, never shared with the frontend.
PASSWORD_PEPPER=change-me-please-use-32+random-bytes

# Separate 32-byte URL-safe base64 key for encrypting TOTP secrets at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production; dev derives an isolated fallback from SECRET_KEY.
MFA_ENCRYPTION_KEY=

# Password reset link lifetime (minutes)
PASSWORD_RESET_TTL_MIN=30

# Rate limits. Memory is for development/tests only; production requires TLS Redis.
RATE_LIMIT_BACKEND=memory
REDIS_URL=
RATE_LIMIT_REDIS_SOCKET_TIMEOUT=1
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_RESET_MAX=3
RATE_LIMIT_MFA_CHALLENGE_MAX=15
RATE_LIMIT_RESET_CONFIRM_MAX=5
RATE_LIMIT_PROFILE_UPDATE_MAX=10
RATE_LIMIT_PROFILE_EMAIL_VERIFY_MAX=5
RATE_LIMIT_MFA_RECOVERY_ROTATE_MAX=5
RATE_LIMIT_SESSIONS_MAX=20
RATE_LIMIT_WINDOW=900

# ---------------------------------------------------------------------------
# Cloudflare Turnstile captcha on LOGIN (docs/CONTRACT.md §7)
#
# Set TURNSTILE_SECRET_KEY to ENABLE the captcha gate on POST /auth/login.
# Leave it EMPTY (default) to run WITHOUT captcha — login then works with
# email+password only, and no fake verification happens anywhere.
#
# When enabled you must ALSO create a Turnstile widget in the Cloudflare
# dashboard and put its SITE key in the frontend env as
# VITE_TURNSTILE_SITE_KEY (see ../frontend/.env.example).
# ---------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=

# Database URL. PREFER FLASK_DATABASE_URL (this app's own namespace).
# A generic DATABASE_URL set by OTHER tools (e.g. Prisma's file:./dev.db)
# is detected and ignored with a startup warning; the default SQLite path
# is used instead. Valid schemes: sqlite:///, postgresql://, mysql://, ...
#FLASK_DATABASE_URL=sqlite:///instance/app.db

# SMTP account mail. For local development use Mailpit (localhost:1025,
# web inbox at http://localhost:8025); production requires TLS and real creds.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@localhost
SMTP_STARTTLS=false
SMTP_USE_SSL=false
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_TIMEOUT_SECONDS=10
